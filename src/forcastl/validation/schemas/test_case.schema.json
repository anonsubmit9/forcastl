{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forcastl:test-case-schema",
  "title": "FORCAST-L Test Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "artefact_type",
    "difficulty",
    "scenario_prompt",
    "expected_findings",
    "hallucination_traps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "artefact_type": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "Easy",
        "Medium",
        "Hard"
      ]
    },
    "test_set": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "scenario_prompt": {
      "type": "string",
      "minLength": 1
    },
    "artefact_file": {
      "type": "string",
      "minLength": 1
    },
    "expected_output": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "expected_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "indicator"
        ],
        "properties": {
          "indicator": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string"
          },
          "evidence_type": {
            "type": "string"
          }
        }
      }
    },
    "hallucination_traps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
